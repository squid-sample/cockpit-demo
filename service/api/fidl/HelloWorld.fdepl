import "platform:/plugin/org.genivi.commonapi.someip/deployment/CommonAPI-4-SOMEIP_deployment_spec.fdepl"
import "HelloWorld.fidl"

define org.genivi.commonapi.someip.deployment for interface demo.HelloWorld {
    SomeIpServiceID = 0x1111

    method sayHello {
        SomeIpMethodID = 0x0001
        SomeIpReliable = true
    }

    method getPowerState {
        SomeIpMethodID = 0x0002
        SomeIpReliable = true
    }

    broadcast NotifyPowerState {
        SomeIpEventID    = 0x8001
        SomeIpReliable   = false
        SomeIpEventGroups = { 0x01 }
    }
}

define org.genivi.commonapi.someip.deployment for provider as HelloWorldProvider {
    instance demo.HelloWorld {
        InstanceId = "demo.HelloWorld"
        SomeIpInstanceID = 0x2222
        SomeIpUnicastAddress = "192.168.0.2"
        SomeIpReliableUnicastPort = 30499
        SomeIpUnreliableUnicastPort = 30499
    }
}